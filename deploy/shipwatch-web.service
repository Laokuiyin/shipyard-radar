[Unit]
Description=Shipyard Radar Web Dashboard
After=network.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/shipyard-radar-main
EnvironmentFile=/opt/shipyard-radar-main/.env
ExecStart=/opt/shipyard-radar-main/venv/bin/python -m shipwatch.cli web --host 0.0.0.0 --port 7890
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
