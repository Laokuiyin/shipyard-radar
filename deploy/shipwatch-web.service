[Unit]
Description=Shipyard Radar Web Dashboard
After=network.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/shipyard-radar
EnvironmentFile=/opt/shipyard-radar/.env
ExecStart=/opt/shipyard-radar/.venv/bin/shipwatch web --host 0.0.0.0 --port 7890
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
